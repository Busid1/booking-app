generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String?
  phone        String?
  /// "user" | "admin" | "staff"
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  reviews      Review[]
  staff        Staff?
}

model Service {
  id           String        @id @default(uuid())
  title        String
  price        Float
  duration     Int
  description  String?
  image        String?
  category     String?
  /// Señal a pagar online al reservar (0 o null = sin señal)
  deposit      Float?
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  staff        Staff[]
}

model Staff {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  bio              String?
  photo            String?
  color            String        @default("#4f46e5")
  active           Boolean       @default(true)
  order            Int           @default(0)
  /// Si es true usa el horario del negocio; si no, el de StaffHours
  useBusinessHours Boolean       @default(true)
  /// Calendario de Google propio (opcional)
  calendarId       String?
  userId           String?       @unique
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  services         Service[]
  hours            StaffHours[]
  appointments     Appointment[]
  reviews          Review[]
  createdAt        DateTime      @default(now())
}

model StaffHours {
  id         String  @id @default(uuid())
  staffId    String
  dayOfWeek  Int
  isClosed   Boolean @default(false)
  /// [{ openTime: "09:00", closeTime: "14:00" }, ...]
  timeBlocks Json    @default("[]")
  staff      Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

model BusinessHours {
  id         String      @id @default(uuid())
  dayOfWeek  Int         @unique
  timeBlocks TimeBlock[]
  isClosed   Boolean
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model BusinessInfo {
  id                Int      @id @default(1)
  name              String   @default("Default Name")
  description       String   @default("Default Description")
  address           String
  phone             String
  email             String
  images            String[]
  instagram         String?
  tiktok            String?
  facebook          String?
  whatsapp          String?
  x                 String?
  youtube           String?
  website           String?
  logo              String?
  primaryColor      String?
  /// Horas mínimas de antelación para que un cliente cancele (0 = sin límite)
  cancellationHours Int      @default(0)
  /// Visibilidad pública de cada dato de contacto
  showAddress       Boolean  @default(true)
  showPhone         Boolean  @default(true)
  showEmail         Boolean  @default(true)
  /// Calendario de Google donde se crean las citas (si un profesional no tiene el suyo)
  googleCalendarId  String?
}

model TimeBlock {
  id              String        @id @default(uuid())
  openTime        String
  closeTime       String
  businessHoursId String
  businessHours   BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Cascade)
}

model Appointment {
  id              String    @id @default(uuid())
  date            String
  startTime       String
  endTime         String
  serviceId       String
  /// null en reservas de invitados
  userId          String?
  staffId         String?
  googleEventId   String?
  clientName      String?
  clientEmail     String?
  clientPhone     String?
  /// "confirmed" | "pending_payment"
  status          String    @default("confirmed")
  /// Código secreto para que el cliente gestione la cita sin cuenta
  manageToken     String?
  stripeSessionId String?
  depositPaid     Float?
  reminderSentAt  DateTime?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff           Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  review          Review?
  createdAt       DateTime  @default(now())

  @@index([date])
  @@index([manageToken])
}

model Review {
  id            String       @id @default(uuid())
  rating        Int
  comment       String?
  authorName    String
  visible       Boolean      @default(true)
  userId        String?
  appointmentId String?      @unique
  staffId       String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  staff         Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
}
